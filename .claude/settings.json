{
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm dev)",
      "Bash(pnpm lint)",
      "Bash(pnpm build)",
      "Bash(pnpm run export-wp)",
      "Bash(pnpm exec playwright *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(node .claude/hooks/*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/check-jid.mjs"],
            "timeout": 15,
            "statusMessage": "J-ID とコミット規約を確認中"
          }
        ]
      }
    ]
  }
}
