{
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm dev)",
      "Bash(pnpm lint)",
      "Bash(pnpm build)",
      "Bash(pnpm test)",
      "Bash(pnpm run export-wp)",
      "Bash(pnpm exec playwright *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git push)",
      "Bash(git push origin main)",
      "Bash(node .claude/hooks/*)"
    ],
    "ask": [
      "Bash(taskkill *)",
      "Bash(kill *)",
      "Bash(pkill *)",
      "Bash(killall *)",
      "PowerShell(Stop-Process *)",
      "PowerShell(taskkill *)",
      "Bash(npx kill-port *)",
      "Bash(rm -rf *)",
      "Bash(rm -r *)",
      "PowerShell(Remove-Item -Recurse *)",
      "PowerShell(Remove-Item * -Recurse *)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(docker compose down*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/check-jid.mjs"],
            "timeout": 15,
            "statusMessage": "J-ID とコミット規約を確認中"
          }
        ]
      }
    ]
  }
}
