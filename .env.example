# hirakiya-fudosan / Docker 用(初案 2026-09-06)
# このファイルをコピーして .env を作る:  copy .env.example .env
# .env は Git に入れない。ローカル専用の値なので、本番の秘密ではない。

# --- WordPress / MySQL -------------------------------------------------
MYSQL_DATABASE=hirakiya
MYSQL_USER=wp
MYSQL_PASSWORD=wp
MYSQL_ROOT_PASSWORD=root

# --- ポート ------------------------------------------------------------
# 3000 は Next.js が使うので空けておく
WP_PORT=8080
PMA_PORT=8081
