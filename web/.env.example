# hirakiya-fudosan / web — 環境変数の雛形(初案 2026-09-07)
# コピーして .env.local を作る(Git 管理外)

# WordPress(Docker)。パーマリンクは「投稿名」にしておく
WORDPRESS_API_URL=http://localhost:8080/wp-json

# データ源:api = 開発時に REST を読む / static = data/*.json を読む(Vercel はこちら)
DATA_SOURCE=api

# 公開 URL(sitemap・canonical・OGP)。本番は Vercel のドメイン
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# フォーム送信(Resend)。3本共通。宛先は SHIN のみ。未設定ならバリデーションだけ通す
RESEND_API_KEY=
CONTACT_EMAIL_FROM=noreply@example.com
CONTACT_EMAIL_TO=

# スパム対策(Cloudflare Turnstile)。採用時に設定
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
